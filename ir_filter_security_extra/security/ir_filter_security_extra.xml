<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <record id="group_ir_filters_allow_delete" model="res.groups" >
            <field name="name">Filters Manager</field>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="category_id" ref="base.module_category_hidden"/>
        </record>
    </data>
    <data noupdate="1">
        <record id="ir_filters_allow_delete_rule" model="ir.rule">
            <field name="name">ir.filters (Allow delete)</field>
            <field name="model_id" ref="base.model_ir_filters"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_ir_filters_allow_delete'))]"/>
            <field name="perm_read" eval="False"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="True"/>
        </record>

    </data>
</odoo>

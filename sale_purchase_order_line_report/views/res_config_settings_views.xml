<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form (sale_purchase_order_line_report)</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='show_margins']" position="after">
                <setting id="sale_purchase_history_mode" string="Sale Purchase History Mode" help="Configure the mode to see the view">
                    <field name="sale_purchase_history_mode" widget="radio"/>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>

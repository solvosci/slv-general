<odoo>

    <data noupdate="0">
        <record id="group_sale_purchase_order_line_report" model="res.groups">
            <field name="name">Sale Purchase Order Line: Can See Report</field>
            <field name="category_id" ref="base.module_category_usability"/> 
            <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman')),(4, ref('purchase.group_purchase_user'))]"/>
            <field name="users" eval="[(4, ref('base.user_admin'))]"/> 
        </record>
    </data>

    <data noupdate="1">
        <record id="sale_purchase_order_line_report_multi_company_rule" model="ir.rule">
            <field name="name">Sale Purchase Order Type multi-company</field>
            <field name="model_id" ref="sale_purchase_order_line_report.model_sale_purchase_order_line" />
            <field name="domain_force">[('company_id','in',company_ids + [False])]</field>
        </record>
    </data>
</odoo>

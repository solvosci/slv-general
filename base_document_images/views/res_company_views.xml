<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_company_form" model="ir.ui.view">
        <field name="name">res.company (in base_document_images)</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form" />
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page name="document_images" string="Document Images">
                    <group>
                        <group>
                            <field name="bdi_signature" widget="image" style="max-width: 150px; max-height: 150px;"/>
                        </group>
                        <group>
                            <field name="bdi_seal" widget="image" style="max-width: 150px; max-height: 150px;"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

</odoo>

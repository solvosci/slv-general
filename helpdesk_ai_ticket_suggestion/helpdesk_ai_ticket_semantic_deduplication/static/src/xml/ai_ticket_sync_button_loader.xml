<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="helpdesk_ai_ticket_semantic_deduplication.AITicketSyncButtonLoader">
        <button type="button" class="btn btn-outline-secondary btn-sm"
                t-att-disabled="props.isLoading"
                title="Reload all tickets into the similarity index"
                t-on-click="() => props.onClick()">
            <i t-if="props.isLoading" class="fa fa-spinner fa-spin me-1" aria-hidden="true"/>
            <i t-else="" class="fa fa-refresh me-1" aria-hidden="true"/>
            <t t-if="props.isLoading">Syncing…</t>
            <t t-else="">Sync tickets</t>
        </button>
    </t>
</templates>

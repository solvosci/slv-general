<odoo>
    <record id="product_template_form_view" model="ir.ui.view">
        <field name="name">product.template.dangerous.class (in l10n_eu_product_adr_local)</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="l10n_eu_product_adr.product_template_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='adr_classification_code']" position="after">
                <field name="un_local_code"/>
            </xpath>
            <xpath expr="//field[@name='adr_packing_instruction_ids']" position="before">
                <field name="packaging_group_id"/>
                <field name="package_description" />
            </xpath>
        </field>
    </record>
</odoo>
